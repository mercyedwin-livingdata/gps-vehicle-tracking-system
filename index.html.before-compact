/* ── RENDERING ── */
function renderStats() {
  const k = kpis;
  $('kVehicles').textContent = k ? k.vehicles_used : '—';
  $('kRoad').textContent     = k ? k.vehicles_on_the_road : '—';
  $('kArrived').textContent  = k ? k.trips_by_status.arrived : '—';
  $('kDelayed').textContent  = k ? k.delayed_trips : '—';
  $('kOnTime').textContent   = k && k.on_time_rate_pct != null ? `${k.on_time_rate_pct}%` : '—';   // no arrived trips yet
  $('kPax').textContent      = k ? `${k.passengers_alighted} / ${k.passengers_booked}` : '—';
  ['scheduled','moving','paused','stopped','arrived','delayed'].forEach(s => { $('sum_' + s).textContent = summary[s] || 0; });
}

function fuelBar(value) {
  value = Math.round(value * 10) / 10;
  const k = value>60 ? 'moving' : value>30 ? 'paused' : 'stopped';
  return `<div class="fuel-wrap"><div class="fuel-bar-bg"><div class="fuel-bar-fill" style="width:${value}%;background:var(--st-${k});"></div></div><span class="fuel-label" style="color:var(--st-${k}-fg);">${value}%</span></div>`;
}

function fmtDuration(mins) {
  const h = Math.floor(mins / 60), m = mins % 60;
  return (h ? `${h} h ` : '') + (m || !h ? `${m} min` : '');
}
/* 'YYYY-MM-DD HH:MM:SS' -> 'HH:MM' (with the date in front when it isn't the selected day) */
function fmtTime(s) {
  if (!s) return '—';
  return (s.slice(0, 10) === selectedDate ? '' : s.slice(5, 10) + ' ') + s.slice(11, 16);
}

function paxLabel(t) {
  if (t.status === 'scheduled' || t.status === 'cancelled') return `${t.passengers_total} booked`;
  return `${t.passengers_onboard}/${t.passengers_total} on board`;
}

/* status badge, plus an orange LATE chip when the trip is late now or arrived late */
function badgesFor(t) {
  const main = `<span class="badge badge-${t.status}">${STATUS[t.status].label}</span>`;
  const late = t.delayed ? `<span class="badge badge-delayed">LATE ${t.late_minutes}m</span>` : '';
  return main + late;
}

