</svg>

<!-- LOGIN -->
<div class="login-screen" id="loginScreen">
  <div class="login-card">
    <form id="loginForm" onsubmit="submitLogin(event)" novalidate>
      <div class="login-title"><span class="company-name">Fleet</span> Login</div>
      <div class="login-subtitle">Sign in to access the fleet tracking dashboard.</div>
      <input id="loginEmail" class="login-field" type="email" placeholder="Email" autocomplete="username" maxlength="120"/>
      <input id="loginPass" class="login-field" type="password" placeholder="Password" autocomplete="current-password" maxlength="128"/>
      <button class="login-button" type="submit" id="loginBtn">Sign In</button>
      <div class="login-error" id="loginError"></div>
      <div class="login-note">No account yet? <button type="button" class="link-btn" onclick="showAuthView('register')">Create account</button></div>
    </form>
    <form id="signupForm" class="hidden" onsubmit="submitSignup(event)" novalidate>
      <div class="login-title">Create account</div>
      <div class="login-subtitle">An admin must approve your account before you can sign in.</div>
      <div id="regFields">
        <input id="regName" class="login-field" type="text" placeholder="Full name" autocomplete="name" maxlength="100"/>
        <input id="regEmail" class="login-field" type="email" placeholder="Email" autocomplete="email" maxlength="120"/>
        <input id="regPass" class="login-field" type="password" placeholder="Password (at least 8 characters)" autocomplete="new-password" maxlength="128"/>
        <input id="regPass2" class="login-field" type="password" placeholder="Confirm password" autocomplete="new-password" maxlength="128"/>
        <button class="login-button" type="submit" id="regBtn">Register</button>
      </div>
      <div class="login-error" id="regError"></div>
      <div class="login-ok hidden" id="regOk"></div>
      <div class="login-note"><button type="button" class="link-btn" onclick="showAuthView('login')">Back to sign in</button></div>
    </form>
  </div>
</div>

<!-- NAV -->
<nav class="navbar">
  <div class="brand">
    <div class="brand-icon"><svg class="icon" aria-hidden="true"><use href="#i-radio"/></svg></div>
    <div>
      <div class="brand-name company-name">Fleet</div>
      <div class="brand-sub">GPS VEHICLE TRACKING · ANAMBRA STATE</div>
    </div>
  </div>
  <div class="nav-center" id="navCenter">
    <div class="admin-menu hidden" id="adminMenu">
      <button type="button" class="theme-btn menu-toggle" id="menuToggle" onclick="toggleMenu()" aria-expanded="false" aria-controls="mainMenu">Menu<span class="count-badge hidden" id="menuBadge"></span></button>
      <div class="main-menu" id="mainMenu" role="navigation" aria-label="Main menu">
        <button type="button" class="menu-item active" data-page="dashboard" onclick="showPage('dashboard')">Dashboard</button>
        <button type="button" class="menu-item" data-page="drivers" onclick="showPage('drivers')">Drivers</button>
        <button type="button" class="menu-item" data-page="vehicles" onclick="showPage('vehicles')">Vehicles</button>
        <button type="button" class="menu-item" data-page="settings" onclick="showPage('settings')">Settings<span class="count-badge hidden" id="pendingBadge"></span></button>
      </div>
    </div>
  </div>
  <div class="nav-right">
    <div class="conn-pill loading" id="connBar" title="Start the server with: python app.py">CONNECTING</div>
    <button id="themeToggle" class="icon-btn" onclick="toggleTheme()" title="Switch to dark mode" aria-label="Switch to dark mode"><svg class="icon" aria-hidden="true"><use href="#i-moon"/></svg></button>
    <div id="clock">00:00:00</div>
    <div class="user-chip hidden" id="userChip"><span id="userName"></span><span class="role-tag hidden" id="userRole"></span></div>
    <button class="theme-btn" id="logoutBtn" onclick="logout()">Logout</button>
  </div>
</nav>

<!-- LAYOUT -->
<div class="layout">
  <aside class="sidebar">
    <div class="sidebar-label" id="fleetLabel">FLEET · 0 VEHICLES</div>
    <div class="sidebar-actions admin-only">
      <button class="add-vehicle-btn" id="addVehicleBtn" onclick="openAddForm()">+ Add Trip</button>
      <button class="theme-btn" id="registerVehicleBtn" onclick="openRegisterForm()">Register Vehicle</button>
    </div>
    <div class="action-msg hidden" id="actionMsg" role="alert"></div>
    <div class="vehicle-list" id="vehicleList"></div>
    <div class="fleet-summary">
      <div class="sidebar-label">FLEET SUMMARY</div>
      <div class="fleet-row"><span>Scheduled</span><span class="count c-scheduled" id="sum_scheduled">0</span></div>
      <div class="fleet-row"><span>Moving</span>   <span class="count c-moving" id="sum_moving">0</span></div>
      <div class="fleet-row"><span>Paused</span>   <span class="count c-paused" id="sum_paused">0</span></div>
      <div class="fleet-row"><span>Stopped</span>  <span class="count c-stopped" id="sum_stopped">0</span></div>
      <div class="fleet-row"><span>Arrived</span>  <span class="count c-arrived" id="sum_arrived">0</span></div>
      <div class="fleet-row"><span>Delayed</span>  <span class="count c-delayed" id="sum_delayed">0</span></div>
    </div>
  </aside>

  <main class="main">
    <div class="showing-line" id="showingLine">Showing: <b></b></div>
    <div class="stats-row">
      <div class="stat-card"><div class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-bus"/></svg></div><div class="stat-label">VEHICLES TODAY</div><div class="stat-value" id="kVehicles">—</div><div class="stat-sub">with a trip</div></div>
      <div class="stat-card k-road"><div class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-route"/></svg></div><div class="stat-label">ON THE ROAD</div><div class="stat-value" id="kRoad">—</div><div class="stat-sub">moving · paused · stopped</div></div>
      <div class="stat-card k-arrived"><div class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-check-circle"/></svg></div><div class="stat-label">ARRIVED</div><div class="stat-value" id="kArrived">—</div><div class="stat-sub">trips completed</div></div>
      <div class="stat-card k-delayed"><div class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg></div><div class="stat-label">DELAYED</div><div class="stat-value" id="kDelayed">—</div><div class="stat-sub">late now or arrived late</div></div>
      <div class="stat-card"><div class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-gauge"/></svg></div><div class="stat-label">ON-TIME RATE</div><div class="stat-value" id="kOnTime">—</div><div class="stat-sub">of arrived trips</div></div>
      <div class="stat-card"><div class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-users"/></svg></div><div class="stat-label">PASSENGERS</div><div class="stat-value" id="kPax">—</div><div class="stat-sub">dropped off / booked</div></div>
      <div class="stat-card k-ai"><div class="stat-icon"><svg class="icon" aria-hidden="true"><use href="#i-sparkles"/></svg></div><div class="stat-label">AI ALERTS</div><div class="stat-value" id="alertCount">0</div><div class="stat-sub">pending</div></div>
    </div>

    <div class="map-row">
      <div class="map-box"><div id="leafletMap"></div></div>
      <div class="detail-panel" id="detailPanel">
        <div class="muted-note">Select a vehicle</div>
      </div>
    </div>

    <div class="alerts-card">
      <div class="alerts-label"> AI PREDICTION ALERTS</div>
      <div id="alertsList"></div>
    </div>

    <div class="report-card">
      <div class="report-head">
        <div class="alerts-label">END OF DAY REPORT · <span id="reportDate"></span></div>
        <div class="report-tools">
          <input type="date" id="datePicker" class="date-input" title="Report date: show trips for this date" aria-label="Report date" onchange="onDateChange(this.value)"/>
