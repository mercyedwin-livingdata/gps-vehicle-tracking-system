let confirmCtx = null;                    // { kind, id }
function askConfirm(kind, id) {
  const t = trips.find(x => x.id === id);
  if (!t) return;
  const what = `${t.model_name} (${t.plate_number}), ${t.origin} → ${t.destination}, ${fmtTime(t.scheduled_departure)}`;
  const texts = {
    cancel: { title: 'Cancel this trip?', yes: 'Yes, cancel the trip', danger: true,
              text: `${what}. It will be removed.` },
    arrive: { title: 'Mark as arrived?', yes: 'Yes, mark as arrived', danger: false,
              text: `${what} will be marked as arrived now.` },
  }[kind];
  confirmCtx = { kind, id };
  $('confirmTitle').textContent = texts.title;
  $('confirmText').textContent = texts.text;
  $('confirmError').textContent = '';
  const yes = $('confirmYes');
