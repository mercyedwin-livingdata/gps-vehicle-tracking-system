    const d = await r.json().catch(() => ({}));
    if (!r.ok) { loadUsers(true); return d.error || `The server answered ${r.status}`; }
    const who = `${d.user.full_name}`;
    showUsersMsg(action === 'approve' ? `${who} approved. They can sign in now.`
