/* REPORTS (Settings, admin only): monthly and yearly PDFs. A period with no trips shows a message instead of a file. */
let repBusy = false, repMsgTimer = null;
function showRepMsg(text, isError) {
  const el = $('repMsg');
  el.textContent = text; el.classList.toggle('error', !!isError);
  clearTimeout(repMsgTimer);
  if (text && !isError) repMsgTimer = setTimeout(() => { el.textContent = ''; }, 6000);
}
async function loadReportYears() {
  const now = new Date(), thisMonth = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
  if (!$('repMonth').value) $('repMonth').value = thisMonth;
  try {
    const r = await fetch(`${API}/api/admin/reports/years`);
    if (!r.ok) return;
    const d = await r.json();
    const sel = $('repYear'), keep = sel.value;
    sel.innerHTML = d.years.map(y => `<option value="${y}">${y}</option>`).join('');
    sel.value = d.years.map(String).includes(keep) ? keep : String(now.getFullYear());
  } catch (e) { /* the buttons still work with whatever is in the list */ }
}
async function downloadPeriod(kind) {
  if (repBusy) return;
  const value = kind === 'month' ? $('repMonth').value : $('repYear').value;
  if (!value) { showRepMsg(kind === 'month' ? 'Choose a month first.' : 'Choose a year first.', true); return; }
  repBusy = true; $('repMonthBtn').disabled = $('repYearBtn').disabled = true;
  showRepMsg('Preparing the PDF…', false);
  try {
    const r = await fetch(`${API}/api/admin/reports/${kind === 'month' ? 'monthly' : 'yearly'}.pdf?${kind}=${encodeURIComponent(value)}`);
    if (!r.ok) {
      let why = `the server answered ${r.status}`;
      try { const d = await r.json(); if (d.error) why = d.error; } catch (e) {}
      showRepMsg(why, true);                           // e.g. "No trips found for April 2026" (no file is downloaded)
      return;
    }
    const blob = await r.blob();
    const m = /filename="?([^";]+)"?/.exec(r.headers.get('Content-Disposition') || '');
    const name = m ? m[1] : (kind === 'month' ? `Monthly_Report_${value}.pdf` : `Yearly_Report_${value}.pdf`);
    const url = URL.createObjectURL(blob), a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 10000);
    showRepMsg(`Downloaded ${name}`, false);
  } catch (e) {
    showRepMsg(e instanceof TypeError ? 'Could not reach the server — is it running (python app.py)?' : e.message, true);
  } finally {
    repBusy = false; $('repMonthBtn').disabled = $('repYearBtn').disabled = false;
  }
}

