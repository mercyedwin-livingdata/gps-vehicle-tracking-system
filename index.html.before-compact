function collectForm() {
  const errors = [];
  const isNew = vehicleMode === 'new';
  const plate = isNew ? $('fPlate').value.trim() : chosenPlate;
  const registered = fleet.find(v => v.plate_number === chosenPlate);
  const model = isNew ? $('fModel').value.trim() : (registered ? registered.model_name : ''), driverId = Number($('fDriver').value);
  const origin = $('fOrigin').value, dest = $('fDest').value, dep = $('fDep').value, arr = $('fArr').value;
  const seats = getSeats();

  if (vehicleMode === 'none') errors.push('Choose a vehicle name from the list, or "+ New vehicle".');
  else {
    if (!plate) errors.push(isNew ? 'Plate number is required.' : 'Choose the plate number.');
    else if (!PLATE_RE.test(plate)) errors.push('Plate number must be 3 to 15 characters: letters, digits and hyphens only.');
    if (!model)  errors.push('Vehicle name is required.');
    if (!seats)  errors.push('Number of seats must be a whole number from 1 to 60.');
  }
  if (!driverId) errors.push($('fDriver').options.length > 1 ? 'Choose a driver.' : 'There is no active driver yet: add one on the Drivers page first.');
  if (!origin) errors.push('Choose point A.');
  if (!dest)   errors.push('Choose point B.');
  if (origin && origin === dest) errors.push('Point A and point B must be different towns.');
  if (!dep) errors.push('Departure time is required.');
  if (!arr) errors.push('Expected arrival time is required.');
  if (dep && arr && updateDuration() === null) errors.push('Expected arrival must be after the departure time.');

  const passengers = [], usedSeats = new Set();
  const rows = [...document.querySelectorAll('#paxRows .pax-row')];
  if (seats && rows.length > seats) errors.push(`${rows.length} passengers exceed the ${seats} seats.`);
  rows.forEach((r, i) => {
    const name = r.querySelector('.pax-name').value.trim(), seat = r.querySelector('.pax-seat').value;
    const drop = r.querySelector('.pax-drop').value;
    if (!name) errors.push(`Passenger ${i + 1}: name is required.`);
    if (!seat) errors.push(`Passenger ${i + 1}: no seat available.`);
    else if (usedSeats.has(seat)) errors.push(`Passenger ${i + 1}: seat "${seat}" is already taken.`);
    else usedSeats.add(seat);
    passengers.push({ passenger_name: name, seat_label: seat, drop_off_location: drop || dest });
  });

  return { errors, isNew, payload: {
    plate_number: plate, model_name: model, seat_count: seats, driver_id: driverId || null,
    origin, destination: dest,
    scheduled_departure: dep.replace('T', ' '), scheduled_arrival: arr.replace('T', ' '),
    passengers,
  }};
}

const serverMessage = (d, fallback) => (d.details && d.details.length ? d.details : [d.error || fallback]).join('\n');

async function submitAddForm(e) {
  e.preventDefault();
  const out = $('formError');
  const { errors, payload, isNew } = collectForm();
  if (errors.length) { out.textContent = errors.join('\n'); return; }
  out.textContent = '';
  const btn = $('submitBtn');
  btn.disabled = true; btn.textContent = 'Saving…';
  let registered = false;
  try {
    if (isNew) {                              // "+ New vehicle": register it first, then create the trip
      const rv = await fetch(`${API}/api/fleet`, { method:'POST', headers:{ 'Content-Type':'application/json' },
        body: JSON.stringify({ plate_number: payload.plate_number, model_name: payload.model_name, seat_count: payload.seat_count }) });
      const dv = await rv.json();
      if (!rv.ok) { out.textContent = serverMessage(dv, 'Could not register the vehicle'); return; }   // no trip is created
      registered = true;
      fleet = sortFleet([...fleet.filter(v => v.plate_number !== dv.plate_number), dv]);
      selectFleetVehicle(dv);                 // the form now shows it as a registered vehicle, so a retry won't register it twice
    }
    const r = await fetch(`${API}/api/trips`, { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
    const d = await r.json();
    if (!r.ok) {
      out.textContent = (registered ? `Vehicle ${payload.plate_number} was registered, but the trip could not be created:\n` : '') + serverMessage(d, 'Could not save the trip');
      return;
    }
    closeAddForm();
    selectedDate = d.trip_date;             // show the day the trip belongs to
    $('datePicker').value = selectedDate;
    selectedTripId = d.id;
    await fetchAll();
  } catch(err) {
    out.textContent = 'Could not reach the server — is it running (python app.py)?';
  } finally {
    btn.disabled = false; btn.textContent = 'Create Trip';
  }
}

/* ── FLEET: choose a vehicle NAME (searchable), then its PLATE. The plate is the unique identifier; names may repeat. ── */
let fleet = [];                 // GET /api/fleet -> [{plate_number, model_name, seat_count}]
let vehicleMode = 'none';       // 'none' | 'fleet' (a registered vehicle name is chosen) | 'new' ("+ New vehicle")
let chosenName = '';            // the vehicle name picked from the list
let chosenPlate = '';           // set once the plate is known: automatically for a one-plate name, or picked by the user
const NEW_VEHICLE = '__new__';
const sortFleet = list => [...list].sort((a, b) => a.model_name.localeCompare(b.model_name) || a.plate_number.localeCompare(b.plate_number));
const fleetLabel = v => `${v.plate_number} - ${v.model_name}`;
const sameName = (a, b) => String(a).trim().toLowerCase() === String(b).trim().toLowerCase();   // "Toyota Sienna" == "toyota sienna"
const platesFor = name => fleet.filter(v => sameName(v.model_name, name)).map(v => v.plate_number).sort();
function fleetNames() {         // each distinct vehicle name once, sorted. Spellings that differ only in letter case are one name;
  const groups = new Map();     // the one shown is the most used spelling (ties: plain character order, so "Toyota" beats "toyota").
  fleet.forEach(v => {
    const k = v.model_name.trim().toLowerCase(), n = v.model_name.trim();
    const g = groups.get(k) || new Map(); g.set(n, (g.get(n) || 0) + 1); groups.set(k, g);
  });
  const shown = [...groups.values()].map(g => [...g.entries()].sort((a, b) => b[1] - a[1] || (a[0] < b[0] ? -1 : 1))[0][0]);
  return shown.sort((a, b) => a.localeCompare(b));
}

async function loadDriverChoices() {          // active drivers only (name and phone), from the admin-only drivers route
  const sel = $('fDriver');
  try {
    const r = await fetch(`${API}/api/admin/drivers`);
    if (!r.ok) throw new Error(`the server answered ${r.status}`);
    const list = (await r.json()).filter(d => d.status === 'active');
    sel.innerHTML = '<option value="">Choose a driver…</option>' +
      list.map(d => `<option value="${d.id}">${esc(d.name)}${d.phone ? ' — ' + esc(d.phone) : ''}</option>`).join('');
    return list.length ? '' : 'There is no active driver yet: add one on the Drivers page first.';
  } catch (e) { return `Could not load the driver list (${e.message}).`; }
}
async function loadFleet() {
  try { fleet = sortFleet(await getJSON(`${API}/api/fleet`)); return ''; }
  catch (e) { return `Could not load the vehicle list (${e.message}). You can still use "+ New vehicle".`; }
}
function lockVehicleFields(locked) { $('fSeats').readOnly = locked; }          // vehicle name is typed only in "+ New vehicle" mode
function currentVehicleLabel() { return vehicleMode === 'new' ? '+ New vehicle' : vehicleMode === 'fleet' ? chosenName : ''; }

/* The plate field has four faces: disabled (no name yet), read-only (one plate), a dropdown (several plates), typed (new vehicle). */
function setPlateField(kind, plate = '', plates = []) {
  const p = $('fPlate'), sel = $('fPlateSelect');
  sel.classList.toggle('hidden', kind !== 'select');
  p.classList.toggle('hidden', kind === 'select');
  p.disabled = kind === 'disabled';
  p.readOnly = kind === 'readonly';
  p.value = (kind === 'readonly') ? plate : '';
  p.placeholder = kind === 'disabled' ? 'Choose a vehicle name first' : 'e.g. AWK-234-XA';
  if (kind === 'select') sel.innerHTML = '<option value="">Choose a plate number…</option>' + plates.map(x => `<option value="${esc(x)}">${esc(x)}</option>`).join('');
}
function resetVehicleFields() {
  vehicleMode = 'none'; chosenName = ''; chosenPlate = '';
  $('fFleetSearch').value = '';
  $('newNameWrap').classList.add('hidden');
  setPlateField('disabled');
  $('fModel').value = ''; $('fSeats').value = '';
  lockVehicleFields(true);
}
function clearVehicleDetails() { chosenPlate = ''; $('fSeats').value = ''; refreshPassengers(); }
function setVehicle(v) {                  // the plate is known: its seats (read-only) follow
  chosenPlate = v.plate_number;
  $('fSeats').value = v.seat_count;
  lockVehicleFields(true);
  refreshPassengers();                    // "0 / <seats>" and the seat dropdowns follow this vehicle's layout
}

function chooseName(name) {
  closeFleetList();
  if (name === NEW_VEHICLE) {             // reveal a typed name, plate and seats
    vehicleMode = 'new'; chosenName = ''; chosenPlate = '';
    $('fFleetSearch').value = currentVehicleLabel();
    $('newNameWrap').classList.remove('hidden');
    setPlateField('typed');
    $('fModel').value = ''; $('fSeats').value = '';
    lockVehicleFields(false); refreshPassengers();
    $('fModel').focus();
    return;
  }
  const plates = platesFor(name);
  if (!plates.length) return;
  vehicleMode = 'fleet'; chosenName = fleetNames().find(n => sameName(n, name)) || name.trim(); chosenPlate = '';
  $('fFleetSearch').value = chosenName;
  $('newNameWrap').classList.add('hidden');
  if (plates.length === 1) {              // exactly one vehicle has this name: fill its plate in (read-only)
    setPlateField('readonly', plates[0]);
    setVehicle(fleet.find(v => v.plate_number === plates[0]));
  } else {                                // several share the name: the user must choose a plate
    setPlateField('select', '', plates);
    clearVehicleDetails();
    $('fPlateSelect').focus();
  }
}
function onPlateSelect() {
  const v = fleet.find(x => x.plate_number === $('fPlateSelect').value);
  if (v) setVehicle(v); else clearVehicleDetails();
}
function selectFleetVehicle(v) {          // show an exact vehicle (used right after "+ New vehicle" registered one)
  chooseName(v.model_name);
  if (!$('fPlateSelect').classList.contains('hidden')) { $('fPlateSelect').value = v.plate_number; onPlateSelect(); }
}

let fleetActive = -1;
const fleetItems = () => [...$('fleetList').querySelectorAll('.combo-item')];
function renderFleetList(query = '') {    // search works by vehicle name only
  const q = query.trim().toLowerCase();
  const names = fleetNames().filter(n => !q || n.toLowerCase().includes(q));
  $('fleetList').innerHTML =
    names.map(n => `<div class="combo-item" role="option" data-name="${esc(n)}">${esc(n)}</div>`).join('') +
    (names.length ? '' : `<div class="combo-empty">No vehicle name matches "${esc(query.trim())}"</div>`) +
    `<div class="combo-item combo-new" role="option" data-name="${NEW_VEHICLE}">+ New vehicle</div>`;      // always the last option
  setFleetActive(-1);
}
function openFleetList(query) { renderFleetList(query); $('fleetList').classList.remove('hidden'); $('fFleetSearch').setAttribute('aria-expanded', 'true'); }
function closeFleetList() { $('fleetList').classList.add('hidden'); $('fFleetSearch').setAttribute('aria-expanded', 'false'); }
function setFleetActive(i) {
  const items = fleetItems();
  items.forEach(x => x.classList.remove('active'));
  fleetActive = items.length && i >= 0 ? (i + items.length) % items.length : -1;
  if (fleetActive >= 0) { items[fleetActive].classList.add('active'); items[fleetActive].scrollIntoView({ block: 'nearest' }); }
}
(function wireFleetCombo() {
  const input = $('fFleetSearch'), list = $('fleetList');
  input.addEventListener('focus', () => { input.select(); openFleetList(''); });           // empty search = every name
  input.addEventListener('input', () => openFleetList(input.value));
  input.addEventListener('keydown', e => {
    const open = !list.classList.contains('hidden');
    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      if (!open) openFleetList('');
      setFleetActive(fleetActive + (e.key === 'ArrowDown' ? 1 : -1));
    } else if (e.key === 'Enter') {
      e.preventDefault();                                                                 // never submits the form from here
      if (open && fleetActive >= 0) chooseName(fleetItems()[fleetActive].dataset.name);
    } else if (e.key === 'Escape' && open) {
      e.stopPropagation(); closeFleetList(); input.value = currentVehicleLabel();
    }
  });
  list.addEventListener('mousedown', e => {                                               // mousedown: runs before the input loses focus
    const it = e.target.closest('.combo-item');
    if (it) { e.preventDefault(); chooseName(it.dataset.name); }
  });
  input.addEventListener('blur', () => { closeFleetList(); input.value = currentVehicleLabel(); });
})();

/* ── REGISTER VEHICLE: saves to the fleet, creates no trip ── */
function setRegMsg(text, ok) { const el = $('rMsg'); el.textContent = text; el.classList.toggle('ok', !!ok); }
function openRegisterForm() {
  $('registerForm').reset(); setRegMsg('', false);
  $('registerModal').classList.remove('hidden');
  $('rPlate').focus();
}
function closeRegisterForm() { $('registerModal').classList.add('hidden'); }

async function submitRegister(e) {
  e.preventDefault();
  const plate = $('rPlate').value.trim(), model = $('rModel').value.trim();
  const seats = Number($('rSeats').value);
  const errors = [];
  if (!plate) errors.push('Plate number is required.');
  else if (!PLATE_RE.test(plate)) errors.push('Plate number must be 3 to 15 characters: letters, digits and hyphens only.');
  if (!model) errors.push('Vehicle name is required.');
  if (!Number.isInteger(seats) || seats < 1 || seats > 60) errors.push('Number of seats must be a whole number from 1 to 60.');
  if (errors.length) { setRegMsg(errors.join('\n'), false); return; }
  const btn = $('registerBtn');
  btn.disabled = true; btn.textContent = 'Saving…'; setRegMsg('', false);
  try {
    const r = await fetch(`${API}/api/fleet`, { method:'POST', headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify({ plate_number: plate, model_name: model, seat_count: seats }) });
    const d = await r.json();
    if (!r.ok) { setRegMsg(serverMessage(d, 'Could not register the vehicle'), false); return; }
    if (isAdmin()) loadAdminVehicles();                               // the Vehicles page shows it too
    fleet = sortFleet([...fleet.filter(v => v.plate_number !== d.plate_number), d]);       // the dropdown has it now, no reload
    setRegMsg(`Registered ${fleetLabel(d)} (${d.seat_count} seats).`, true);
    $('registerForm').reset();
    $('rPlate').focus();
  } catch(err) {
    setRegMsg('Could not reach the server — is it running (python app.py)?', false);
  } finally {
    btn.disabled = false; btn.textContent = 'Register Vehicle';
  }
}

function startDashboard() {
  if (dashboardStarted) { fetchAll(); return; }     // logging in again must not build a second map / timer
  dashboardStarted = true;
  renderAll();
  setTimeout(async () => {
    await loadConfig();
    initMap();
    fetchAll();
    setInterval(fetchAll, REFRESH_MS);
    checkHealth();
    setInterval(checkHealth, HEALTH_MS);
  }, 100);
}

initAuth();                                  // last: everything it may call is defined above
