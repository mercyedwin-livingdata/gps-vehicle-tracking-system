<script>
const API = location.port === '5000' ? location.origin : 'http://localhost:5000';   // served by Flask: same origin as the login cookie
const REFRESH_MS = 10000;          // the whole dashboard (map, cards, KPIs, alerts, report) refreshes together

/* Status labels. The colours live in ONE place - the CSS variables --st-<key> (and the .badge-<key> classes) - and
   solid() reads them, so cards, map markers and the report table can't drift apart. */
const STATUS = {
  moving:    { label:'MOVING' },
  paused:    { label:'PAUSED' },
  stopped:   { label:'STOPPED' },
  arrived:   { label:'ARRIVED' },
  delayed:   { label:'LATE' },
  scheduled: { label:'SCHEDULED' },
  cancelled: { label:'CANCELLED' },
};
function solid(key) { return getComputedStyle(document.body).getPropertyValue('--st-' + key).trim() || '#7b888e'; }
/* line icon from the sprite at the top of the page */
function ico(name, extra = '') { return `<svg class="icon ${extra}" aria-hidden="true"><use href="#i-${name}"/></svg>`; }
const ON_THE_ROAD = ['moving', 'paused', 'stopped'];
// buttons shown on a trip card, by trip status: [api action, label]
const TRIP_ACTIONS = {
  scheduled: [['start','Start'], ['edit','Edit'], ['cancel','Cancel']],
  moving:    [['pause','Pause'], ['stop','Stop'], ['arrive','Arrive']],
  paused:    [['resume','Resume'], ['stop','Stop'], ['arrive','Arrive']],
  stopped:   [['resume','Resume'], ['arrive','Arrive']],
  arrived:   [],
  cancelled: [],
};

function todayStr() {
  const d = new Date();
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function esc(v) {
  return String(v ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
const $ = id => document.getElementById(id);

let selectedDate      = todayStr();
let trips             = [];     // every trip on selectedDate, any status (from /api/trips/report)
let vehicles          = [];     // vehicles on the road on selectedDate (moving / paused / stopped)
let summary           = {};     // report.summary: trip counts by status for selectedDate
let kpis              = null;   // /api/kpis for selectedDate
let aiByVehicle       = {};     // vehicle id -> /api/ai/predict result, for vehicles on the road only
let selectedTripId    = null;
let dismissedAlerts   = [];
let flaskOnline       = false;
let leafletMap        = null;
let tileLayer         = null;
let leafletMarkers    = {};
let fetchToken        = 0;
let dashboardStarted  = false;
let dropCtx           = null;   // {tripId, passengerId} while the drop-off dialog is open
let appConfig         = { company_name:'Fleet', map_center:{ lat:6.188, lng:6.927, zoom:10 }, towns:{} };  // overwritten by /api/config

/* CLOCK */
setInterval(() => { $('clock').textContent = new Date().toLocaleTimeString('en-GB'); }, 1000);
$('datePicker').value = selectedDate;

/* THEME */
const preferredTheme = localStorage.getItem('gpsDashboardTheme') || 'light';
applyTheme(preferredTheme);

function applyTheme(theme) {
  const isDark = theme === 'dark';
  document.body.classList.toggle('dark-mode', isDark);
  const btn = $('themeToggle');
  if (btn) {                                   // a small icon button: the moon offers dark mode, the sun goes back to light
    btn.innerHTML = ico(isDark ? 'sun' : 'moon');
    btn.title = btn.ariaLabel = isDark ? 'Switch to light mode' : 'Switch to dark mode';
  }
  localStorage.setItem('gpsDashboardTheme', theme);
  if (leafletMap) { addTiles(isDark); renderMarkers(); }
}
function toggleTheme() { applyTheme(document.body.classList.contains('dark-mode') ? 'light' : 'dark'); }

/* LOGIN: real accounts stored in MySQL (auth.py). The login lives in a session cookie, so every request carries it. */
const _fetch = window.fetch.bind(window);
window.fetch = async (url, opts = {}) => {
  const r = await _fetch(url, { credentials: 'include', ...opts });
  if (r.status === 401 && currentUser && !String(url).includes('/api/auth/')) signedOut();   // session ended: back to the login screen
  return r;
};
let currentUser = null;
const isViewer = () => !!currentUser && currentUser.role !== 'admin';   // the server enforces this too; the page only hides what a viewer can't use
function applyRole() {
  document.body.classList.toggle('viewer', isViewer());
}
function signedOut() {
  currentUser = null;
  $('userChip').classList.add('hidden');
  $('adminMenu').classList.add('hidden'); showPage('dashboard'); clearAdminData();
  applyRole();
  showLoginScreen('Please sign in again');
}

function showAuthView(view) {
  $('loginForm').classList.toggle('hidden', view !== 'login');
  $('signupForm').classList.toggle('hidden', view !== 'register');
  $('loginError').textContent = ''; $('regError').textContent = '';
  if (view === 'register') {                 // a fresh, empty form every time
    $('signupForm').reset();
    $('regFields').classList.remove('hidden'); $('regOk').classList.add('hidden');
    $('regName').focus();
  } else $('loginEmail').focus();
}
function showLoginScreen(message) {
  $('loginScreen').classList.remove('hidden');
  showAuthView('login');
  $('loginError').textContent = message || '';
}
function hideLoginScreen() { $('loginScreen').classList.add('hidden'); }

/* ADMIN MENU + PAGES: pages are only shown/hidden, so the map is never rebuilt and the polling never restarts */
const isAdmin = () => !!currentUser && currentUser.role === 'admin';
const PAGES = ['drivers', 'vehicles', 'settings'];
let currentPage = 'dashboard';
function showPage(name) {
  if (name !== 'dashboard' && (!isAdmin() || !PAGES.includes(name))) name = 'dashboard';
  currentPage = name;
  document.querySelector('.layout').classList.toggle('hidden', name !== 'dashboard');
  PAGES.forEach(p => $('page-' + p).classList.toggle('hidden', p !== name));
  document.querySelectorAll('.menu-item').forEach(b => b.classList.toggle('active', b.dataset.page === name));
  closeMenu();
  if (name === 'dashboard' && leafletMap) setTimeout(() => leafletMap.invalidateSize(), 50);   // the map was hidden: re-measure it
  if (name === 'settings') { loadUsers(true); loadReportYears(); }
  if (name === 'vehicles') loadAdminVehicles();
  if (name === 'drivers') loadAdminDrivers();
}
function toggleMenu() { const open = $('mainMenu').classList.toggle('open'); $('menuToggle').setAttribute('aria-expanded', open); }
function closeMenu() { $('mainMenu').classList.remove('open'); $('menuToggle').setAttribute('aria-expanded', 'false'); }
document.addEventListener('click', e => { if (!e.target.closest('#adminMenu')) closeMenu(); });

/* VEHICLES + DRIVERS PAGES (admin only; the server refuses everyone else with 403) */
let adminVehicles = [], adminDrivers = [], vehMsgTimer = null, vehEditId = null;
function phoneProblem(v) {                   // optional: digits, spaces, dashes and a leading +; 7 to 15 digits
  v = (v || '').trim();
  if (!v) return '';
  if (!/^[0-9+\-\s]+$/.test(v) || v.indexOf('+') > 0) return 'Phone number: digits, spaces, dashes and a leading + only.';
  const digits = (v.match(/\d/g) || []).length;
  return digits < 7 || digits > 15 ? 'Phone number must have 7 to 15 digits, e.g. +234 803 123 4567.' : '';
}
const telLink = p => p ? `<a class="tel-link" href="tel:${esc(p.replace(/[^\d+]/g, ''))}">${esc(p)}</a>` : '<span class="cell-sub">—</span>';
const statusBadge = st => `<span class="badge badge-${esc(st)}">${esc(st.toUpperCase())}</span>`;
const matches = (q, ...fields) => !q || fields.some(f => (f || '').toLowerCase().includes(q));
function showVehMsg(text, isError) {
  const el = $('vehMsg');
  el.textContent = text; el.classList.toggle('error', !!isError);
  clearTimeout(vehMsgTimer);
  if (text) vehMsgTimer = setTimeout(() => { el.textContent = ''; }, 6000);
}
let vehLoadSeq = 0, vehShown = 'active';
async function loadAdminVehicles() {
  if (!isAdmin()) return;
  const removed = $('vehShowRemoved').checked, seq = ++vehLoadSeq;
