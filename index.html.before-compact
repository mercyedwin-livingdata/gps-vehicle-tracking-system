function closeConfirm() { $('confirmModal').classList.add('hidden'); confirmCtx = null; }

async function runConfirm() {
  if (!confirmCtx) return;
  const { kind, id } = confirmCtx;
  const yes = $('confirmYes');
  yes.disabled = true; $('confirmError').textContent = '';
  try {
    if (kind.startsWith('remove-')) {      // remove a driver / vehicle: the server decides between delete and keep-for-reports
      const what = kind.slice(7);
      const r = await fetch(`${API}/api/admin/${what === 'driver' ? 'drivers' : 'vehicles'}/${id}`, { method: 'DELETE' });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) { $('confirmError').textContent = d.error || `The server answered ${r.status}`; return; }   // e.g. "Cancel or finish trip #N first."
      closeConfirm();
      await afterRemoveOrRestore(what, d.message);
      return;
    }
    if (kind.startsWith('user-')) {        // reject / revoke a member (Settings page)
      const err = await userAction(id, kind.slice(5));
      if (err) { $('confirmError').textContent = err; return; }
      closeConfirm();
      return;
    }
    const r = kind === 'cancel'            // cancelling a scheduled trip removes it completely
      ? await fetch(`${API}/api/trips/${id}`, { method:'DELETE' })
      : await fetch(`${API}/api/trips/${id}/${kind}`, { method:'POST', headers:{ 'Content-Type':'application/json' }, body:'{}' });
    const d = await r.json().catch(() => ({}));
    if (!r.ok) {                           // the server's reason, shown in the modal (the trip may have changed meanwhile: refresh too)
      $('confirmError').textContent = d.error || `The server answered ${r.status}`;
      fetchAll();
      return;
    }
    closeConfirm();
    await fetchAll();                      // cards, KPI cards, markers, alerts and the report all refresh
  } catch(e) {
    $('confirmError').textContent = 'Could not reach the server — is it running (python app.py)?';
  } finally {
    yes.disabled = false;
  }
}

