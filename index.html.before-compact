/* Rebuild every seat dropdown from the layout: keep valid unique choices, give seatless rows the next free seat,
   and disable seats another row already holds so two passengers can't share one. */
function refreshPassengers() {
  const n = getSeats(), layout = seatLabels(n);
  const rows = [...document.querySelectorAll('#paxRows .pax-row')];
  const taken = new Set();
  const want = rows.map(r => {
    const s = r.querySelector('.pax-seat').value;
    if (layout.includes(s) && !taken.has(s)) { taken.add(s); return s; }
    return '';
  });
  const free = layout.filter(s => !taken.has(s));
  rows.forEach((r, i) => { if (!want[i] && free.length) want[i] = free.shift(); });
  rows.forEach((r, i) => {
    const sel = r.querySelector('.pax-seat');
    sel.innerHTML = layout.map(s =>
      `<option value="${esc(s)}" ${want.includes(s) && want[i] !== s ? 'disabled' : ''}>${esc(s)}</option>`).join('');
    sel.value = want[i] || '';
