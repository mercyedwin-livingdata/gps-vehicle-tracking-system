             ${isViewer() ? '' : `<div class="detail-actions"><button class="theme-btn" onclick="refuelVehicle(${veh.id})">Refuel</button></div>`}
             ${aiByVehicle[veh.id] ? aiBoxHtml(aiByVehicle[veh.id]) : ''}` : ''}`;
}

/* ── AI PREDICTION ALERTS: only for trips on the road, from the real /api/ai/predict result ── */
function buildAlerts() {
  const out = [];
  trips.filter(t => ON_THE_ROAD.includes(t.status)).forEach(t => {
    const veh = vehicles.find(v => v.trip_id === t.id);
    const route = `${t.origin} → ${t.destination}`;
    const tag = `${STATUS[t.status].label} · ${t.plate_number}`;
    if (t.delayed) {
      out.push({ id:`late-${t.id}`, type:'warning', icon:'clock', time:tag,
                 msg:`${esc(t.model_name)} is ${t.late_minutes} min late on ${esc(route)}` });
    }
    const ai = veh && aiByVehicle[veh.id];
    if (ai) {
      const type = { high:'warning', medium:'info', low:'success' }[ai.risk] || 'neutral';
      const icon = { warning:'triangle-alert', info:'route', success:'check-circle', neutral:'info' }[type];
      let msg = `<b>${esc(t.model_name)}</b> on ${esc(route)}: ${esc(ai.prediction)} — ${esc(ai.suggestion)}`;
      const alts = ai.route_option && ai.route_option.alternatives || [];
      if (alts.length) {
        msg += `<br>Alternative route: ${alts.map(esc).join(' or ')}`;
        if (ai.route_option.recommend_alternative) msg += ` (saves ${esc(ai.route_option.estimated_saving)})`;
      }
      out.push({ id:`ai-${t.id}`, type, icon, time:`${tag} · risk ${ai.risk} · ${ai.confidence || '—'}% confidence`, msg });
    }
  });
  return out;
}

function renderAlerts() {
  const onRoad = trips.some(t => ON_THE_ROAD.includes(t.status));
  const active = buildAlerts().filter(a => !dismissedAlerts.includes(a.id));
  $('alertCount').textContent = active.filter(a => a.type === 'warning' || a.type === 'info').length;
  $('alertsList').innerHTML = !onRoad
    ? '<div class="muted-note">No active trips</div>'
    : !active.length
      ? '<div class="muted-note">No active alerts</div>'
      : active.map(a => `<div class="alert-item alert-${a.type}"><div><div class="alert-msg">${ico(a.icon)}${a.msg}</div><div class="alert-time">${esc(a.time)}</div></div><button class="dismiss-btn" onclick="dismissAlert('${a.id}')" aria-label="Dismiss">${ico('x')}</button></div>`).join('');
}

