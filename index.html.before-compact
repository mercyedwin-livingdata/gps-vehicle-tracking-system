function editAddPassengerRow(p) {         // p = an existing passenger (pre-fill), or nothing for a new blank row
  if (!editCtx) return;
  const rows = $('ePaxRows');
  if (!p && rows.children.length >= editCtx.seats) {
    $('editError').textContent = `This vehicle only has ${editCtx.seats} seat${editCtx.seats === 1 ? '' : 's'}.`;
    return;
  }
  $('editError').textContent = '';
  const row = document.createElement('div');
  row.className = 'pax-row';
  if (p) row.dataset.pid = p.id;          // an existing passenger keeps its id; a row without one is added
  row.innerHTML = `
    <input class="login-field pax-name" maxlength="100" placeholder="Passenger name" autocomplete="off" value="${esc(p ? p.passenger_name : '')}"/>
    <select class="login-field pax-seat" data-want="${esc(p ? p.seat_label : '')}" onchange="refreshEditPassengers()"></select>
    <select class="login-field pax-drop">${dropOptions(p ? p.drop_off_location : $('eDest').value)}</select>
    <button type="button" class="theme-btn" onclick="this.parentElement.remove();refreshEditPassengers()">Remove</button>`;
  rows.appendChild(row);
  refreshEditPassengers();
  if (!p) row.querySelector('.pax-name').focus();
}

/* same seat logic as the Add Trip form, on this modal's rows: valid unique choices are kept, seatless rows get the next
   free seat, and a seat another row holds is disabled so two passengers can't share one */
function refreshEditPassengers() {
  const n = editCtx ? editCtx.seats : 0, layout = seatLabels(n);
  const rows = [...document.querySelectorAll('#ePaxRows .pax-row')];
  const taken = new Set();
  const want = rows.map(r => {
    const sel = r.querySelector('.pax-seat');
    const s = sel.value || sel.dataset.want || '';
    sel.dataset.want = '';
    if (layout.includes(s) && !taken.has(s)) { taken.add(s); return s; }
    return '';
  });
  const free = layout.filter(s => !taken.has(s));
  rows.forEach((r, i) => { if (!want[i] && free.length) want[i] = free.shift(); });
  rows.forEach((r, i) => {
    const sel = r.querySelector('.pax-seat');
    sel.innerHTML = layout.map(s => `<option value="${esc(s)}" ${want.includes(s) && want[i] !== s ? 'disabled' : ''}>${esc(s)}</option>`).join('');
    sel.value = want[i] || '';
  });
  $('ePaxCount').textContent = `· ${rows.length} / ${n || '?'}`;
}

function collectEdit() {
  const errors = [];
  const dest = $('eDest').value, dep = $('eDep').value, arr = $('eArr').value;
  if (!dest) errors.push('Choose point B.');
  if (dest && dest === editCtx.origin) errors.push('Point A and point B must be different towns.');
  if (!dep) errors.push('Departure time is required.');
  if (!arr) errors.push('Expected arrival time is required.');
  if (dep && arr && updateEditDuration() === null) errors.push('Expected arrival must be after the departure time.');
  const rows = [...document.querySelectorAll('#ePaxRows .pax-row')], used = new Set(), passengers = [];
  if (rows.length > editCtx.seats) errors.push(`${rows.length} passengers exceed the ${editCtx.seats} seats.`);
  rows.forEach((r, i) => {
    const name = r.querySelector('.pax-name').value.trim(), seat = r.querySelector('.pax-seat').value, drop = r.querySelector('.pax-drop').value;
    if (!name) errors.push(`Passenger ${i + 1}: name is required.`);
    if (!seat) errors.push(`Passenger ${i + 1}: no seat available.`);
    else if (used.has(seat)) errors.push(`Passenger ${i + 1}: seat "${seat}" is already taken.`);
    else used.add(seat);
    const item = { passenger_name: name, seat_label: seat, drop_off_location: drop || dest };
    if (r.dataset.pid) item.id = Number(r.dataset.pid);
    passengers.push(item);
  });
  const payload = { destination: dest, passengers };
  if (dep !== editCtx.dep) payload.scheduled_departure = dep.replace('T', ' ');      // send only what changed
  if (arr !== editCtx.arr) payload.scheduled_arrival = arr.replace('T', ' ');
  return { errors, payload };
}

async function submitEdit(e) {
  e.preventDefault();
  if (!editCtx) return;
  const out = $('editError');
  const { errors, payload } = collectEdit();
  if (errors.length) { out.textContent = errors.join('\n'); return; }
  out.textContent = '';
  const btn = $('editSaveBtn');
  btn.disabled = true; btn.textContent = 'Saving…';
  try {
    const r = await fetch(`${API}/api/trips/${editCtx.id}`, { method:'PUT', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(payload) });
    const d = await r.json();
    if (!r.ok) { out.textContent = serverMessage(d, 'Could not save the changes'); fetchAll(); return; }
    closeEditTrip();
    selectedDate = d.trip_date;            // the departure may have moved to another day: show that day
    $('datePicker').value = selectedDate;
    selectedTripId = d.id;
    await fetchAll();
  } catch(err) {
    out.textContent = 'Could not reach the server — is it running (python app.py)?';
  } finally {
    btn.disabled = false; btn.textContent = 'Save changes';
  }
}

