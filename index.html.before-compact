function aiBoxHtml(d) {
  return `<div class="ai-box ${esc(d.risk)}"><div class="eyebrow">${ico('sparkles')} AI PREDICTION</div><div>${esc(d.prediction)}</div><div class="ai-note">→ ${esc(d.suggestion)}</div><div class="ai-note ai-small">Confidence: ${esc(d.confidence||'—')}%</div></div>`;
}

function renderDetail() {
  const panel = $('detailPanel');
  const t = trips.find(x => x.id === selectedTripId);
  if (!t) {
    panel.innerHTML = '<div class="muted-note">Select a vehicle</div>';
    return;
  }
  const veh = vehicles.find(v => v.trip_id === t.id);
  const rows = [
    ['Driver', t.driver_name], ['Plate No.', t.plate_number], ['Seats', t.seat_count],
    ['Route', `${t.origin} → ${t.destination}`],
    ['Departure (sched.)', (t.scheduled_departure || '').slice(0, 16)],
    ['Arrival (sched.)',   (t.scheduled_arrival || '').slice(0, 16)],
    ['Est. duration', fmtDuration(t.estimated_duration_minutes)],
    ['Departed', t.actual_departure ? t.actual_departure.slice(0, 16) : '—'],
    ['Arrived',  t.actual_arrival   ? t.actual_arrival.slice(0, 16)   : '—'],
  ];
  if (t.delayed) rows.push([t.status === 'arrived' ? 'Delay' : 'Late so far', `${t.late_minutes} min`]);
  if (t.delay_reason) rows.push(['Delay reason', t.delay_reason]);
  if (veh) rows.push(['Speed', `${veh.speed || 0} km/h`], ['ETA', veh.eta || '—'], ['Latitude', veh.latitude], ['Longitude', veh.longitude]);

  panel.innerHTML = `
    <div>
      <div class="eyebrow">SELECTED VEHICLE</div>
