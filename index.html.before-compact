<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate"/>
<meta http-equiv="Pragma" content="no-cache"/>
<meta http-equiv="Expires" content="0"/>
<title>Fleet Dashboard</title>

<!-- ── LEAFLET ── -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<style>
  /* ═══════════════════════════════════════════════════════════════════
     DESIGN TOKENS - the one palette. Everything below uses these variables.
     Light is the default; body.dark-mode overrides the surface, text and soft status colours.
     ═══════════════════════════════════════════════════════════════════ */
  :root {
    --font: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;

    /* surfaces and text */
    --bg: #edf2f4;            /* page */
    --card: #ffffff;          /* every card / panel */
    --card-2: #f3f7f8;        /* inset areas: share box, hover, inputs */
    --border: #d3dfe3;
    --text: #10282f;
    --muted: #556d76;

    /* brand: deep teal primary, one violet accent */
    --primary: #0b5563;
    --primary-hover: #083f4a;
    --on-primary: #ffffff;
    --primary-soft: #dcecef;
    --link: #0b5563;
    --accent: #6a4fd1;
    --accent-soft: #ebe7fa;

    /* shape, spacing and type scale (shared by every card) */
    --radius: 12px;
    --radius-sm: 8px;
    --pad: 14px;
    --gap: 14px;
    --fs-label: 10px;         /* small uppercase labels, table headers, badges */
    --fs-small: 11px;
    --fs-body: 12px;
    --fs-title: 15px;
    --fs-kpi: 26px;
    --shadow: 0 1px 2px rgba(16, 40, 47, 0.06);

    /* status: one solid colour (markers, bars, icons) + readable text/background/border for badges */
    --st-moving: #1b8a5a;     --st-moving-fg: #0b5d3b;     --st-moving-bg: #def3e8;     --st-moving-bd: #a6dcc0;
    --st-paused: #b7791f;     --st-paused-fg: #744a0a;     --st-paused-bg: #fbefcf;     --st-paused-bd: #ecd08a;
    --st-stopped: #cc3b47;    --st-stopped-fg: #9b1c27;    --st-stopped-bg: #fce3e5;    --st-stopped-bd: #f0a9ae;
    --st-arrived: #3a7ae0;    --st-arrived-fg: #1c4a9c;    --st-arrived-bg: #deeafb;    --st-arrived-bd: #a9c5ee;
    --st-delayed: #d9651a;    --st-delayed-fg: #9a3f08;    --st-delayed-bg: #fde8d6;    --st-delayed-bd: #f3bb8f;
    --st-scheduled: #6b7b83;  --st-scheduled-fg: #3f5058;  --st-scheduled-bg: #e7edef;  --st-scheduled-bd: #c8d3d8;
    --st-cancelled: #7b888e;  --st-cancelled-fg: #5a676d;  --st-cancelled-bg: #f0f3f4;  --st-cancelled-bd: #d5dde0;
  }
  body.dark-mode {
    --bg: #081a20;
    --card: #10252d;
    --card-2: #0b1d24;
    --border: #243f4a;
    --text: #e4eff2;
    --muted: #93adb6;

    --primary: #2aa3b8;
    --primary-hover: #4bbccf;
    --on-primary: #04222a;
    --primary-soft: #14363f;
    --link: #6cd0e0;
    --accent: #a99bff;
    --accent-soft: #261f4a;

    --shadow: 0 1px 2px rgba(0, 0, 0, 0.35);

    --st-moving-fg: #7fe3ae;     --st-moving-bg: #11382a;     --st-moving-bd: #1f6a4a;
    --st-paused-fg: #f1c86e;     --st-paused-bg: #382b0c;     --st-paused-bd: #6a5018;
    --st-stopped-fg: #ff9fa8;    --st-stopped-bg: #401a1f;    --st-stopped-bd: #7b2b34;
    --st-arrived-fg: #9fc3ff;    --st-arrived-bg: #14284b;    --st-arrived-bd: #2b4f8c;
    --st-delayed-fg: #ffb07d;    --st-delayed-bg: #3f2209;    --st-delayed-bd: #7b4313;
    --st-scheduled-fg: #bccbd1;  --st-scheduled-bg: #1b2d34;  --st-scheduled-bd: #36505a;
    --st-cancelled-fg: #93a3aa;  --st-cancelled-bg: #162830;  --st-cancelled-bd: #2b414a;
    color-scheme: dark;
  }

  /* ── BASE ── */
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: var(--font); font-size: var(--fs-body); background: var(--bg); color: var(--text); height: 100vh; display: flex; flex-direction: column; }
  button, input, select, textarea { font-family: inherit; color: inherit; }
  .hidden { display: none !important; }
  .icon { width: 1em; height: 1em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; vertical-align: -0.15em; flex-shrink: 0; }

  /* one label style: card titles, table headers, form labels, sub-captions */
  .label, .brand-sub, .sidebar-label, .stat-label, .alerts-label, .report-table th, .form-grid label, .share-box label, .eyebrow {
    font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.12em; color: var(--muted);
  }
  .muted-note { color: var(--muted); font-size: var(--fs-small); text-align: center; padding: var(--pad); }

  /* ── ONE CARD STYLE: same radius, border, padding, shadow ── */
  .stat-card, .map-box, .detail-panel, .alerts-card, .report-card, .vehicle-card, .modal-card, .login-card {
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: var(--shadow);
  }
  .stat-card, .detail-panel, .alerts-card, .report-card, .vehicle-card { padding: var(--pad); }

  /* ── BUTTONS (all share one shape) ── */
  .theme-btn { border: 1px solid var(--border); background: var(--card); color: var(--text); border-radius: var(--radius-sm); padding: 6px 12px; cursor: pointer; font-size: var(--fs-small); font-weight: 600; transition: background 0.15s, border-color 0.15s; }
  .theme-btn:hover { background: var(--primary-soft); border-color: var(--primary); }
  .theme-btn:disabled { opacity: 0.55; cursor: wait; }
  .login-button, .add-vehicle-btn { border: none; background: var(--primary); color: var(--on-primary); border-radius: var(--radius-sm); font-weight: 700; cursor: pointer; transition: background 0.15s; }
  .login-button:hover, .add-vehicle-btn:hover { background: var(--primary-hover); }
  .login-button:disabled { opacity: 0.6; cursor: wait; }
  .dismiss-btn { display: inline-flex; align-items: center; justify-content: center; width: 24px; height: 24px; background: none; border: none; border-radius: 6px; cursor: pointer; color: var(--muted); font-size: 14px; flex-shrink: 0; }
  .dismiss-btn:hover { color: var(--text); background: var(--card-2); }
  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ── FIELDS ── */
  .login-field, .date-input, .share-input, .reason-input {
    border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--card-2); color: var(--text);
    font-size: var(--fs-body); padding: 8px 10px;
  }
  .login-field:focus, .date-input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
  .login-field::placeholder, .share-input::placeholder, .reason-input::placeholder { color: var(--muted); opacity: 1; }
  .date-input { cursor: pointer; padding: 6px 10px; }

  /* ── LOGIN ── */
  .login-screen { position: fixed; inset: 0; background: var(--bg); display: flex; align-items: center; justify-content: center; z-index: 9999; }
  .login-card { width: min(400px, calc(100% - 40px)); padding: 28px; box-shadow: 0 18px 50px rgba(16, 40, 47, 0.14); }
  .login-title { font-size: 22px; font-weight: 800; color: var(--primary); margin-bottom: 6px; }
  body.dark-mode .login-title { color: var(--text); }
  .login-subtitle { font-size: var(--fs-body); color: var(--muted); margin-bottom: 22px; }
  .login-card .login-field { width: 100%; margin-bottom: 12px; padding: 12px 14px; font-size: 14px; }
  .login-button { width: 100%; padding: 12px 18px; font-size: 14px; }
  .login-note { margin-top: 14px; font-size: var(--fs-small); color: var(--muted); }
  .login-error { margin-top: 8px; font-size: var(--fs-body); color: var(--st-stopped-fg); min-height: 18px; }
  .login-ok { margin-top: 8px; font-size: var(--fs-body); font-weight: 600; color: var(--st-moving-fg); background: var(--st-moving-bg); border: 1px solid var(--st-moving-bd); border-radius: var(--radius-sm); padding: 10px 12px; }
  .link-btn { border: none; background: none; padding: 0; font: inherit; font-weight: 600; color: var(--accent); cursor: pointer; text-decoration: underline; }
  .user-chip { display: flex; align-items: center; gap: 6px; font-size: var(--fs-small); font-weight: 600; color: var(--text); }
  .viewer .admin-only { display: none !important; }
  .role-tag { text-transform: uppercase; font-size: 10px; letter-spacing: 0.06em; padding: 2px 7px; border-radius: 10px; background: var(--card-2); color: var(--muted); border: 1px solid var(--border); }

  /* ── NAVBAR ── */
  .navbar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px 16px; padding: 8px 24px; min-height: 56px; flex: 0 0 auto; background: var(--card); border-bottom: 1px solid var(--border); }   /* never squashed: it grows when it wraps */
  .nav-center { flex: 1 1 0; min-width: 0; }                      /* empty for now: a menu goes here later */
  .brand { display: flex; align-items: center; gap: 12px; }
  .brand-icon { width: 34px; height: 34px; border-radius: var(--radius-sm); background: var(--primary); color: var(--on-primary); display: flex; align-items: center; justify-content: center; font-size: 18px; }
  .brand-name { font-size: 16px; font-weight: 800; color: var(--text); letter-spacing: 0.04em; }
  .brand-sub { font-size: var(--fs-label); letter-spacing: 0.16em; }
  .nav-right { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 8px 12px; }
  #clock { font-size: var(--fs-body); color: var(--muted); font-variant-numeric: tabular-nums; }
  .showing-line { font-size: var(--fs-small); color: var(--muted); }
  .showing-line b { color: var(--text); font-weight: 700; }
  .report-tools { display: flex; align-items: center; justify-content: flex-end; flex-wrap: wrap; gap: 8px 14px; }
  @media (max-width: 900px) { .brand-sub { display: none; } }
  @media (max-width: 640px) { .navbar { padding: 8px 12px; } }

  /* admin menu (header centre), pages, approvals */
  .navbar { position: relative; }
  .nav-center { display: flex; justify-content: center; }
  .admin-menu { display: flex; align-items: center; }
  .main-menu { display: flex; align-items: center; gap: 4px; }
  .menu-item { display: inline-flex; align-items: center; border: none; background: none; color: var(--muted); font: inherit; font-size: var(--fs-body); font-weight: 600; padding: 6px 12px; border-radius: var(--radius-sm); cursor: pointer; transition: background 0.15s, color 0.15s; }
  .menu-item:hover { background: var(--card-2); color: var(--text); }
  .menu-item.active { background: var(--primary-soft); color: var(--primary); }
  body.dark-mode .menu-item.active { color: var(--link); }
  .menu-toggle { display: none; align-items: center; }
  .count-badge { display: inline-flex; align-items: center; justify-content: center; min-width: 18px; height: 18px; padding: 0 5px; margin-left: 6px; border-radius: 9px; background: var(--st-stopped); color: #fff; font-size: 11px; font-weight: 700; line-height: 1; }
  @media (max-width: 760px) {
    .menu-toggle { display: inline-flex; }
    .main-menu { display: none; position: absolute; top: 100%; left: 12px; z-index: 60; flex-direction: column; align-items: stretch; min-width: 190px; padding: 6px; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius); box-shadow: 0 10px 30px rgba(16, 40, 47, 0.16); }
    .main-menu.open { display: flex; }
    .menu-item { justify-content: space-between; text-align: left; }
  }
  .page { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: var(--gap); display: flex; flex-direction: column; gap: var(--gap); align-items: stretch; }
  .page-title { font-size: 20px; font-weight: 800; color: var(--text); margin: 4px 0 6px; }
  .users-table { min-width: 560px; }
  .search-input { width: 230px; max-width: 100%; padding: 6px 10px; font-size: var(--fs-body); }
  .badge-idle { background: var(--card-2); color: var(--muted); border-color: var(--border); }
  .tel-link { color: var(--accent); font-weight: 600; text-decoration: none; white-space: nowrap; }
  .tel-link:hover { text-decoration: underline; }
  .form-hint { font-size: var(--fs-small); color: var(--muted); margin-top: 10px; }
  .users-table td, .users-table th { vertical-align: middle; }
  .row-actions { white-space: nowrap; }
  .switch-line { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-small); color: var(--muted); cursor: pointer; user-select: none; }
  .switch-line input { width: 15px; height: 15px; accent-color: var(--accent); cursor: pointer; }
  .date-filter { display: inline-flex; align-items: center; gap: 6px; }
  .btn-small { padding: 4px 10px; font-size: var(--fs-small); }
  .period-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px 24px; }
  .period-box label { display: block; margin-bottom: 6px; font-size: var(--fs-small); font-weight: 700; letter-spacing: .08em; color: var(--muted); }
  .period-line { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
  #reportsCard .users-msg { margin: 12px 0 0; }
  .users-msg { font-size: var(--fs-body); margin-bottom: 8px; min-height: 0; }
  .users-msg:not(:empty) { padding: 8px 12px; border-radius: var(--radius-sm); font-weight: 600; background: var(--st-moving-bg); color: var(--st-moving-fg); border: 1px solid var(--st-moving-bd); }
  .users-msg.error:not(:empty) { background: var(--st-stopped-bg); color: var(--st-stopped-fg); border-color: var(--st-stopped-bd); }
  .status-chip { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 2px 8px; border-radius: 10px; border: 1px solid; }
  .status-chip.approved { background: var(--st-moving-bg); color: var(--st-moving-fg); border-color: var(--st-moving-bd); }
  .status-chip.rejected { background: var(--st-stopped-bg); color: var(--st-stopped-fg); border-color: var(--st-stopped-bd); }
  .icon-btn { width: 32px; height: 32px; border-radius: 50%; background: var(--primary-soft); color: var(--primary); border: none; display: flex; align-items: center; justify-content: center; font-size: 16px; cursor: pointer; }
  body.dark-mode .icon-btn { color: var(--link); }
  .icon-btn:hover { background: var(--border); }

  /* ── CONNECTION BAR ── */
  .conn-pill { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 12px; border-radius: 14px; border: 1px solid; font-size: var(--fs-small); font-weight: 400; white-space: nowrap; cursor: default; }
  .conn-pill::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .conn-pill.connected::before { animation: pulse 1.6s ease-in-out infinite; }
  .conn-pill.connected    { background: var(--st-moving-bg);  color: var(--st-moving-fg);  border-color: var(--st-moving-bd); }
  .conn-pill.disconnected { background: var(--st-stopped-bg); color: var(--st-stopped-fg); border-color: var(--st-stopped-bd); }
  .conn-pill.dbdown,
  .conn-pill.loading      { background: var(--st-arrived-bg); color: var(--st-arrived-fg); border-color: var(--st-arrived-bd); }
  .spinner { display: inline-block; width: 12px; height: 12px; border: 2px solid var(--st-arrived-bd); border-top-color: var(--st-arrived); border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 6px; }

  .layout { display: flex; flex: 1 1 auto; min-height: 0; }      /* fills what the (possibly wrapped) header leaves */

  /* ── STATUS BADGES ── */
  .badge { display: inline-block; font-size: var(--fs-label); font-weight: 700; letter-spacing: 0.06em; padding: 2px 8px; border-radius: 999px; border: 1px solid; line-height: 1.5; white-space: nowrap; }
  .badge-moving    { background: var(--st-moving-bg);    color: var(--st-moving-fg);    border-color: var(--st-moving-bd); }
  .badge-paused    { background: var(--st-paused-bg);    color: var(--st-paused-fg);    border-color: var(--st-paused-bd); }
  .badge-stopped   { background: var(--st-stopped-bg);   color: var(--st-stopped-fg);   border-color: var(--st-stopped-bd); }
  .badge-arrived   { background: var(--st-arrived-bg);   color: var(--st-arrived-fg);   border-color: var(--st-arrived-bd); }
  .badge-delayed   { background: var(--st-delayed-bg);   color: var(--st-delayed-fg);   border-color: var(--st-delayed-bd); }
  .badge-scheduled { background: var(--st-scheduled-bg); color: var(--st-scheduled-fg); border-color: var(--st-scheduled-bd); }
  .badge-cancelled { background: var(--st-cancelled-bg); color: var(--st-cancelled-fg); border-color: var(--st-cancelled-bd); text-decoration: line-through; }
  .badges { display: inline-flex; gap: 4px; flex-wrap: wrap; justify-content: flex-start; }

  /* ── SIDEBAR / FLEET LIST ── */
  .sidebar { width: 272px; background: var(--bg); border-right: 1px solid var(--border); display: flex; flex-direction: column; overflow-y: auto; flex-shrink: 0; padding: 0 var(--gap) var(--gap); gap: 0; }
  .sidebar-label { padding: var(--gap) 2px 8px; }
  .add-vehicle-btn { display: block; width: 100%; margin: 0 0 var(--gap); padding: 10px 12px; font-size: 13px; }
  .vehicle-list { display: flex; flex-direction: column; gap: 10px; }
  .vehicle-card { cursor: pointer; border-left: 4px solid var(--border); transition: background 0.15s, box-shadow 0.15s; }
  .vehicle-card:hover { background: var(--card-2); }
  .vehicle-card.active { background: var(--primary-soft); box-shadow: 0 0 0 1px var(--primary); }
  .vc-top    { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; margin-bottom: 6px; }
  .vc-name   { font-size: 13px; font-weight: 700; color: var(--text); }
  .vc-driver { font-size: var(--fs-small); color: var(--muted); margin-bottom: 4px; }
  .vc-route  { font-size: var(--fs-small); color: var(--text); margin-bottom: 6px; }
  .fuel-wrap     { display: flex; align-items: center; gap: 8px; }
  .fuel-bar-bg   { flex: 1; height: 4px; background: var(--border); border-radius: 2px; overflow: hidden; }
  .fuel-bar-fill { height: 100%; border-radius: 2px; transition: width 0.5s; }
  .fuel-label    { font-size: var(--fs-small); font-weight: 600; min-width: 34px; text-align: right; }
  .vc-actions { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 8px; }
  .vc-actions .theme-btn { padding: 4px 10px; }
  .vc-paxlist { margin-top: 8px; border-top: 1px solid var(--border); padding-top: 2px; }
  .vc-pax { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 5px 0; font-size: var(--fs-small); color: var(--text); border-bottom: 1px dashed var(--border); }
  .vc-pax:last-child { border-bottom: none; }
  .pax-plan { color: var(--muted); font-size: var(--fs-small); }
  .pax-done { display: inline-flex; align-items: center; gap: 4px; color: var(--st-arrived-fg); font-size: var(--fs-small); font-weight: 600; text-align: right; }
  .pax-btn { padding: 3px 8px; white-space: nowrap; }
  .empty-state { padding: var(--pad); text-align: center; color: var(--muted); font-size: var(--fs-body); }
  .empty-state .empty-title { font-size: 13px; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .fleet-summary { margin-top: auto; padding-top: var(--gap); }
  .fleet-summary .sidebar-label { padding-left: 2px; }
  .fleet-row { display: flex; justify-content: space-between; font-size: var(--fs-body); padding: 3px 2px; color: var(--muted); }
  .fleet-row .count { font-weight: 700; }
  .c-scheduled { color: var(--st-scheduled-fg); } .c-moving { color: var(--st-moving-fg); } .c-paused { color: var(--st-paused-fg); }
  .c-stopped { color: var(--st-stopped-fg); } .c-arrived { color: var(--st-arrived-fg); } .c-delayed { color: var(--st-delayed-fg); }

  /* ── MAIN ── */
  .main { flex: 1; overflow-y: auto; padding: var(--gap); display: flex; flex-direction: column; gap: var(--gap); }

  /* ── KPI CARDS: the icon takes the card's accent colour (--c) ── */
  .stats-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(135px, 1fr)); gap: var(--gap); }
  .stat-card { --c: var(--primary); }
  .stat-card.k-road { --c: var(--st-moving); } .stat-card.k-arrived { --c: var(--st-arrived); }
  .stat-card.k-delayed { --c: var(--st-delayed); } .stat-card.k-ai { --c: var(--accent); }
  .stat-icon { margin-bottom: 10px; width: 30px; height: 30px; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; font-size: 16px; color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); }
  .stat-label { margin-bottom: 6px; }
  .stat-value { font-size: var(--fs-kpi); font-weight: 800; line-height: 1.15; color: var(--text); }
  .stat-sub   { font-size: var(--fs-small); color: var(--muted); margin-top: 2px; }

  /* ── MAP + DETAIL ── */
  .map-row { display: grid; grid-template-columns: 1fr 290px; gap: var(--gap); height: 320px; }
  .map-box { overflow: hidden; }
  #leafletMap { width: 100%; height: 100%; z-index: 1; font-family: var(--font); }
  body.dark-mode .leaflet-tile-pane { filter: brightness(0.8) saturate(0.85); }
  .leaflet-bar a, .leaflet-bar a:hover { background: var(--card); color: var(--text); border-color: var(--border); }
  .leaflet-container a.leaflet-popup-close-button { color: var(--muted); }
  .leaflet-popup-content-wrapper, .leaflet-popup-tip { background: var(--card); color: var(--text); border-radius: var(--radius) !important; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2) !important; }
  .leaflet-popup-content { margin: var(--pad); }
  .map-popup { font-family: var(--font); font-size: var(--fs-body); min-width: 170px; }
  .map-popup .popup-title { display: flex; align-items: center; gap: 6px; font-weight: 700; font-size: 13px; margin-bottom: 8px; color: var(--text); }
  .map-popup .popup-row   { display: flex; justify-content: space-between; margin-bottom: 4px; }
  .map-popup .popup-label { color: var(--muted); margin-right: 8px; }
  .leaflet-marker-icon.vehicle-icon { transition: transform 0.7s ease-out; }

  .detail-panel { display: flex; flex-direction: column; gap: 10px; overflow-y: auto; }
  .detail-title { font-size: var(--fs-title); font-weight: 800; color: var(--text); margin: 4px 0; }
  .detail-row   { display: flex; justify-content: space-between; gap: 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border); font-size: var(--fs-body); }
  .detail-row span:first-child { color: var(--muted); }
  .detail-row span:last-child  { color: var(--text); font-weight: 600; text-align: right; }

  /* AI prediction box: same soft status colours */
  .ai-box { border-radius: var(--radius-sm); padding: 10px 12px; border: 1px solid; font-size: var(--fs-body); line-height: 1.6; }
  .ai-box .eyebrow { display: flex; align-items: center; gap: 6px; color: inherit; margin-bottom: 4px; }
  .ai-box.low     { background: var(--st-moving-bg);    border-color: var(--st-moving-bd);    color: var(--st-moving-fg); }
  .ai-box.medium  { background: var(--st-paused-bg);    border-color: var(--st-paused-bd);    color: var(--st-paused-fg); }
  .ai-box.high    { background: var(--st-stopped-bg);   border-color: var(--st-stopped-bd);   color: var(--st-stopped-fg); }
  .ai-box.unknown { background: var(--st-scheduled-bg); border-color: var(--st-scheduled-bd); color: var(--st-scheduled-fg); }

  /* ── ALERTS ── */
  .alerts-label { margin-bottom: 10px; }
  .alert-item { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; border-radius: var(--radius-sm); padding: 8px 10px; margin-bottom: 8px; border: 1px solid var(--border); background: var(--card-2); font-size: var(--fs-body); }
  .alert-item:last-child { margin-bottom: 0; }
  .alert-item .alert-msg  { flex: 1; line-height: 1.5; color: inherit; }
  .alert-item .alert-msg .icon { margin-right: 4px; }
  .alert-item .alert-time { font-size: var(--fs-small); opacity: 0.85; margin-top: 2px; }
  .alert-item .dismiss-btn { color: inherit; opacity: 0.7; }
  .alert-warning { background: var(--st-delayed-bg);   border-color: var(--st-delayed-bd);   color: var(--st-delayed-fg); }
  .alert-info    { background: var(--st-arrived-bg);   border-color: var(--st-arrived-bd);   color: var(--st-arrived-fg); }
  .alert-success { background: var(--st-moving-bg);    border-color: var(--st-moving-bd);    color: var(--st-moving-fg); }
  .alert-neutral { background: var(--st-scheduled-bg); border-color: var(--st-scheduled-bd); color: var(--st-scheduled-fg); }

  /* ── END OF DAY REPORT ── */
  .report-head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin-bottom: 10px; }
  .report-head .alerts-label { margin-bottom: 0; }
  .head-actions, .row-actions { display: flex; gap: 6px; align-items: center; }
  .head-actions .theme-btn, .row-actions .theme-btn { white-space: nowrap; }
  .report-msg { font-size: var(--fs-body); margin-bottom: 8px; color: var(--muted); }
  .report-msg.error { color: var(--st-stopped-fg); font-weight: 600; }
  .report-scroll { overflow-x: auto; }
  .report-table { width: 100%; border-collapse: collapse; font-size: var(--fs-body); min-width: 880px; }
  .report-table th { text-align: left; padding: 8px; border-bottom: 2px solid var(--border); }
  .report-table td { padding: 9px 8px; border-bottom: 1px solid var(--border); vertical-align: top; color: var(--text); }
  .report-table tbody tr:hover td { background: var(--card-2); }
  .report-table .share-row:hover td { background: transparent; }
  .report-table .cell-sub { font-size: var(--fs-small); color: var(--muted); }
  .report-table .delay-cell { color: var(--st-delayed-fg); font-weight: 700; }
  .report-table .pax-cell { min-width: 205px; }
  .report-table .pax-cell div { padding: 1px 0; }
  .report-empty { text-align: center; color: var(--muted); padding: 22px 10px !important; }
  .reason-wrap { display: flex; gap: 6px; align-items: center; min-width: 165px; }
  .reason-input { flex: 1; min-width: 0; }
  .reason-wrap .theme-btn { padding: 5px 10px; }
  .pdf-btn:disabled { cursor: wait; }

  /* share boxes */
  .share-row td { padding: 0 !important; border-bottom: none !important; }
  .share-box { padding: var(--pad); margin: 2px 0 var(--gap); border: 1px dashed var(--border); border-radius: var(--radius); background: var(--card-2); }
  .share-box label { display: block; margin-bottom: 6px; }
  .share-line { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .share-input { flex: 1 1 260px; max-width: 420px; }
  .share-line .theme-btn { padding: 6px 14px; }
  .share-cancel { font-size: var(--fs-body); color: var(--link); text-decoration: underline; cursor: pointer; }
  .share-msg { font-size: var(--fs-body); font-weight: 600; margin-top: 6px; min-height: 16px; }
  .share-msg.ok { color: var(--st-moving-fg); }
  .share-msg.error { color: var(--st-stopped-fg); }

  /* ── MODALS: add vehicle, drop off ── */
  .modal-overlay { position: fixed; inset: 0; background: rgba(8, 26, 32, 0.6); display: flex; align-items: flex-start; justify-content: center; overflow-y: auto; padding: 32px 16px; z-index: 2000; }
  .modal-card { width: min(720px, 100%); padding: 22px 24px; box-shadow: 0 18px 50px rgba(0, 0, 0, 0.3); }
  .modal-card.modal-sm { width: min(420px, 100%); }
  .modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
  .modal-title { font-size: 17px; font-weight: 800; color: var(--text); }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 14px; }
  .form-grid.single { grid-template-columns: 1fr; }
  .form-grid label { display: block; margin-bottom: 4px; letter-spacing: 0.08em; }
  .form-grid .login-field, .pax-row .login-field { width: 100%; padding: 9px 11px; font-size: 13px; }
  .form-wide { grid-column: 1 / -1; }
  .duration-line { font-size: var(--fs-body); font-weight: 700; color: var(--st-arrived-fg); }
  .duration-line.bad { color: var(--st-stopped-fg); }
  .pax-head { display: flex; justify-content: space-between; align-items: center; margin: 18px 0 8px; font-size: var(--fs-body); font-weight: 700; color: var(--text); }
  .pax-head .count-note { font-weight: 400; color: var(--muted); }
  .pax-row { display: grid; grid-template-columns: 1.2fr 1fr 1fr auto; gap: 8px; margin-bottom: 8px; align-items: center; }
  .form-error { color: var(--st-stopped-fg); font-size: var(--fs-body); margin-top: 12px; white-space: pre-line; min-height: 18px; }
  .modal-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 14px; }
  .modal-actions .login-button { width: auto; padding: 9px 22px; font-size: 13px; }
  .modal-actions .theme-btn { padding: 9px 18px; font-size: 13px; }
  @media (max-width: 640px) { .form-grid { grid-template-columns: 1fr; } .pax-row { grid-template-columns: 1fr 1fr; } }

  /* fleet dropdown (searchable) and locked fields */
  .combo { position: relative; }
  .combo .login-field { width: 100%; }
  .combo-list { position: absolute; left: 0; right: 0; top: calc(100% + 4px); z-index: 30; max-height: 240px; overflow-y: auto; background: var(--card); border: 1px solid var(--border); border-radius: var(--radius-sm); box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2); padding: 4px; }
  .combo-item { padding: 8px 10px; border-radius: 6px; cursor: pointer; font-size: var(--fs-body); color: var(--text); }
  .combo-item:hover, .combo-item.active { background: var(--primary-soft); }
  .combo-new { color: var(--link); font-weight: 700; border-top: 1px solid var(--border); margin-top: 4px; border-radius: 0 0 6px 6px; }
  .combo-empty { padding: 8px 10px; color: var(--muted); font-size: var(--fs-body); }
  .login-field[readonly], .login-field:disabled { background: var(--card-2); color: var(--muted); cursor: default; }
  .login-field:disabled { cursor: not-allowed; }
  .login-field[readonly]:focus { border-color: var(--border); box-shadow: none; }
  .form-error.ok { color: var(--st-moving-fg); font-weight: 600; }
  .sidebar-actions { display: flex; gap: 8px; margin-bottom: var(--gap); }
  .sidebar-actions .add-vehicle-btn { width: auto; flex: 1 1 auto; margin: 0; }
  .sidebar-actions .theme-btn { flex: 0 0 auto; white-space: nowrap; padding: 6px 10px; }

  /* edit / cancel / delete */
  .theme-btn.danger { color: var(--st-stopped-fg); border-color: var(--st-stopped-bd); }
  .theme-btn.danger:hover { background: var(--st-stopped-bg); border-color: var(--st-stopped); }
  .login-button.danger { background: var(--st-stopped); }
  .login-button.danger:hover { filter: brightness(0.9); background: var(--st-stopped); }
  .action-msg { font-size: var(--fs-small); font-weight: 600; color: var(--st-stopped-fg); background: var(--st-stopped-bg); border: 1px solid var(--st-stopped-bd); border-radius: var(--radius-sm); padding: 6px 10px; margin: 0 0 var(--gap); white-space: pre-line; }
  .confirm-text { font-size: 13px; line-height: 1.55; color: var(--text); }
  .pax-row .theme-btn { white-space: nowrap; padding: 6px 10px; }

  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
  @keyframes spin  { to{transform:rotate(360deg)} }
  .drop-who { font-size: 13px; margin-bottom: 14px; }
  .popup-actions, .detail-actions { margin-top: 8px; }
  .popup-actions { text-align: right; }
  .fuel-eyebrow { margin-bottom: 6px; }
  .ai-note { margin-top: 4px; opacity: 0.85; }
  .ai-small { font-size: var(--fs-small); opacity: 0.75; }
</style>
</head>
<body>
<!-- ICONS: one inline SVG sprite (24x24 line icons). Use: <svg class="icon"><use href="#i-name"/></svg>. They take the text colour. -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <symbol id="i-bus" viewBox="0 0 24 24"><path d="M8 6v6"/><path d="M15 6v6"/><path d="M2 12h19.6"/><path d="M18 18h3s.5-1.7.8-2.8c.1-.4.2-.8.2-1.2 0-.4-.1-.8-.2-1.2l-1.4-5C20.1 6.8 19.1 6 18 6H4a2 2 0 0 0-2 2v10h3"/><circle cx="7" cy="18" r="2"/><path d="M9 18h5"/><circle cx="16" cy="18" r="2"/></symbol>
  <symbol id="i-car" viewBox="0 0 24 24"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><path d="M9 17h6"/><circle cx="17" cy="17" r="2"/></symbol>
