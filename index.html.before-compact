/* PDF downloads: every button is disabled while one is loading; a failure is shown above the table */
let pdfBusy = false;
let reportMsgTimer = null;
function setPdfBusy(busy) {
  pdfBusy = busy;
  document.querySelectorAll('.pdf-btn').forEach(b => { b.disabled = busy; });
}
function showReportMsg(text, isError) {
  const el = $('reportMsg');
  el.textContent = text;
  el.classList.toggle('error', !!isError);
  clearTimeout(reportMsgTimer);
  if (text && !isError) reportMsgTimer = setTimeout(() => { el.textContent = ''; }, 5000);
}

async function downloadPdf(path, fallbackName) {
  if (pdfBusy) return;
  setPdfBusy(true);
  showReportMsg('Preparing the PDF…', false);
  try {
    const r = await fetch(`${API}${path}`);
    if (!r.ok) {
      let why = `the server answered ${r.status}`;
      try { const d = await r.json(); if (d.error) why = d.error; } catch(e) {}
      throw new Error(why);
    }
    const blob = await r.blob();
    const m = /filename="?([^";]+)"?/.exec(r.headers.get('Content-Disposition') || '');
    const name = m ? m[1] : fallbackName;
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 10000);
    showReportMsg(`Downloaded ${name}`, false);
  } catch(e) {
    const offline = e instanceof TypeError;            // fetch() itself failed: server down / unreachable
    showReportMsg(`PDF download failed: ${offline ? 'could not reach the server — is it running (python app.py)?' : e.message}`, true);
  } finally {
    setPdfBusy(false);
  }
}
/* SHARE BY EMAIL. State lives here (not in the DOM) so the 10-second refresh can rebuild the table
   without closing a box or clearing what the user typed. */
const share = {};        // trip id -> { email, busy, msg, ok }
let shareAll = null;     // null = closed, otherwise { email, busy, msg, ok }

function shareBoxHtml(ids, s, label, send, cancel) {
  return `<label for="${ids.input}">${label}</label>
    <div class="share-line">
      <input class="login-field share-input" id="${ids.input}" type="text" inputmode="email" maxlength="254" autocomplete="off"
             placeholder="name@example.com" value="${esc(s.email)}"
             oninput="${send.state}.email=this.value"
             onkeydown="if(event.key==='Enter'){event.preventDefault();${send.call};}"/>
      <button class="theme-btn" id="${ids.btn}" ${s.busy ? 'disabled' : ''} onclick="${send.call}">${s.busy ? 'Sending...' : 'Send'}</button>
      <a class="share-cancel" href="#" onclick="${cancel};return false;">Cancel</a>
    </div>
    <div class="share-msg ${s.msg ? (s.ok ? 'ok' : 'error') : ''}" id="${ids.msg}">${esc(s.msg)}</div>`;
}
function shareRowHtml(t) {
  const s = share[t.id];
  if (!s) return '';
  return `<tr class="share-row"><td colspan="10"><div class="share-box">` +
    shareBoxHtml({ input:`shareEmail-${t.id}`, btn:`shareBtn-${t.id}`, msg:`shareMsg-${t.id}` }, s,
      'Email this trip report (PDF) to', { state:`share[${t.id}]`, call:`sendShare(${t.id})` }, `closeShare(${t.id})`) +
    `</div></td></tr>`;
}
/* update a box in place (no rebuild, so focus and typed text stay put) */
function paintShare(ids, s) {
  const btn = $(ids.btn), msg = $(ids.msg);
  if (btn) { btn.disabled = s.busy; btn.textContent = s.busy ? 'Sending...' : 'Send'; }
  if (msg) { msg.textContent = s.msg; msg.className = 'share-msg ' + (s.msg ? (s.ok ? 'ok' : 'error') : ''); }
}

async function postShare(url, s, ids) {
  if (s.busy) return;
  const email = s.email.trim();
  if (!email) { s.ok = false; s.msg = 'Enter an email address.'; paintShare(ids, s); return; }
  s.busy = true; s.msg = ''; paintShare(ids, s);
  try {
    const r = await fetch(url, { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify({ email }) });
    const d = await r.json().catch(() => ({}));
    s.ok = r.ok;
    s.msg = r.ok ? (d.message || `Sent to ${email}`) : (d.error || `The server answered ${r.status}`);
  } catch(e) {
    s.ok = false;
    s.msg = 'Could not reach the server — is it running (python app.py)?';
  } finally {
    s.busy = false;
    paintShare(ids, s);
  }
}

function openShare(id) {
  if (!share[id]) share[id] = { email:'', busy:false, msg:'', ok:false };
  renderReport(true);
  const input = $(`shareEmail-${id}`);
  if (input) input.focus();
}
function closeShare(id) { delete share[id]; renderReport(true); }
function sendShare(id) {
  const s = share[id];
  if (s) return postShare(`${API}/api/trips/${id}/report/email`, s, { btn:`shareBtn-${id}`, msg:`shareMsg-${id}` });
}

function renderShareAll() {
  const box = $('shareAllBox');
  if (!shareAll) { box.classList.add('hidden'); box.innerHTML = ''; return; }
