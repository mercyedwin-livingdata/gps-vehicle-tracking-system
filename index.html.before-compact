/* ── ADD VEHICLE / TRIP FORM ── */
const PLATE_RE = /^[A-Za-z0-9-]{3,15}$/;

function seatLabels(n) {            // same layout as the server: Front, then rows of three
  const pos = ['Left', 'Middle', 'Right'], out = ['Front'];
  for (let i = 0; i < n - 1; i++) out.push(`Row ${Math.floor(i / 3) + 2} - ${pos[i % 3]}`);
  return out.slice(0, n);
}
function getSeats() {
  const n = Number($('fSeats').value);
  return Number.isInteger(n) && n >= 1 && n <= 60 ? n : 0;
}
function pad(n) { return String(n).padStart(2, '0'); }
function localInput(d) { return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`; }

